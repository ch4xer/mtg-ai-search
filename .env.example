# ───────── Database ─────────
# Used by docker-compose to provision the pgvector container.
POSTGRES_PASSWORD=change-me

# ───────── Chat LLM (DeepSeek) ─────────
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ───────── Embedding API (SiliconFlow) ─────────
# Used to vectorize cards/abilities for semantic search.
# Embedding model is fixed at Qwen/Qwen3-Embedding-4B in code.
# https://siliconflow.cn/
SILICONFLOW_API_KEY=

# ───────── Auth ─────────
# Generate a strong random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# Optional: bootstrap admin account on first startup.
# Leave blank to register the admin via the UI instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ───────── Email (optional) ─────────
# Required only if you want users to verify email / reset password via Resend.
# https://resend.com/api-keys
RESEND_API_KEY=

# ───────── CORS / Misc (optional) ─────────
# Comma-separated. Defaults to local Vite/CRA dev origins.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
